<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 3.1.3 is the oldest 3.1 the TV ships. We target netcoreapp3.1 so the .dll runs on
         everything 3.1.x and up, and we DO NOT publish self-contained — Samsung's bundled
         dotnet is the one with cap_setgid/cap_sys_admin that we want executing this. -->
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>TizenSsh</RootNamespace>
    <AssemblyName>TizenSsh</AssemblyName>
    <!-- Keep the output small; no reflection trimming needed since we barely use any. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- FxSsh 1.5.3 is the last release and targets netstandard2.0, so it loads cleanly on
         the TV's bundled .NET Core 3.1. The library signs host-key proofs with SHA-1
         (`ssh-rsa`), which modern OpenSSH disabled by default — the README tells the user
         to pass `-o HostKeyAlgorithms=+ssh-rsa` on first connect. -->
    <PackageReference Include="FxSsh" Version="1.5.3" />
  </ItemGroup>

</Project>
